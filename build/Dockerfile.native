# Build FFmpeg's libav* + the libav-direct engine → a NATIVE driver binary
# (spec 0028 Backend B, the hardware-acceleration / native-speed escape hatch).
# The wasm build is build/Dockerfile; this shares the same scripts via TARGET=native.
#
# Usage: docker build -f build/Dockerfile.native --target artifact -o dist .
#        → dist/driver  (a native ELF the afmpeg pkg/afmpeg/native host drives)
FROM debian:bookworm-slim AS build
# Unset means "whatever build/ffmpeg-version.txt says" — see build/Dockerfile.
ARG FFMPEG_VERSION=
ARG VARIANT=lgpl
ARG PROFILE=lean
ENV TARGET=native
# build-essential + nasm give native asm/threads; curl/xz-utils/meson/ninja-build
# are the intermediate-profile dep toolchain (same set as the wasm image), only
# exercised when PROFILE=intermediate pulls the Opus/WebP/VP8-9/subtitle libs; cmake
# is the full-profile toolchain (x265/SVT-AV1 are cmake builds).
RUN apt-get update && apt-get install -y --no-install-recommends \
        git make cmake pkg-config ca-certificates build-essential nasm zlib1g-dev \
        curl xz-utils meson ninja-build \
        && rm -rf /var/lib/apt/lists/*
WORKDIR /work
# External encoders (openh264, + libx264 on gpl) first — cached across engine
# edits, so iterating on the driver reuses the deps + libav layers. Native builds
# them with real asm + threads.
COPY build/toolchain.sh build/deps.sh build/config.sub /work/build/
RUN VARIANT="$VARIANT" PROFILE="$PROFILE" sh build/deps.sh
COPY build/libav.sh build/ffmpeg-concat-ioopen.patch \
     build/ffmpeg-version.sh build/ffmpeg-version.txt /work/build/
RUN FFMPEG_VERSION="${FFMPEG_VERSION:-$(sh build/ffmpeg-version.sh)}" \
    VARIANT="$VARIANT" PROFILE="$PROFILE" sh build/libav.sh
COPY build/ /work/build/
COPY src/ /work/src/
RUN OUT=/dist/driver sh build/driver.sh

# Export just the native driver binary.
FROM scratch AS artifact
COPY --from=build /dist/ /
