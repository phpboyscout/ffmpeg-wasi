 /* standard file protocol */
 
+/* afmpeg (spec 0043 D1): the native IPC bridge serves the URL layer too, so a
+ * URL libav opens on its OWN initiative resolves against the caller's
+ * filesystem rather than the host's. Without this, avio_check resolved on the
+ * host while io_open resolved over the bridge, and probe and open disagreed
+ * about which filesystem exists -- which is what ffmpeg-wasi#36 was.
+ * Implemented in the engine's src/nativeio.c; applied on the native build only. */
+int afmpeg_url_active(void);
+int afmpeg_url_open(const char *filename, int flags);
+int afmpeg_url_read(int fd, unsigned char *buf, int size);
+int afmpeg_url_write(int fd, const unsigned char *buf, int size);
+int64_t afmpeg_url_seek(int fd, int64_t pos, int whence);
+int afmpeg_url_close(int fd);
+int afmpeg_url_check(const char *filename, int mask);
+int afmpeg_url_move(const char *src, const char *dst);
+int afmpeg_url_delete(const char *filename);
+
 typedef struct FileContext {
     const AVClass *class;
     int fd;
+    int afmpeg;                 /* this handle is a bridge session, not a file */
     int trunc;
     int blocksize;
     int pkt_size;
